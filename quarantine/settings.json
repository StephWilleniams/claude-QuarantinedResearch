{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": ["WebSearch", "WebFetch"],
    "deny": ["Bash", "Edit", "Write", "NotebookEdit", "Read", "Glob", "Grep", "Agent"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 -I /opt/qr/hooks/fetch_guard.py || exit 2", "timeout": 10 }
        ]
      }
    ]
  }
}
