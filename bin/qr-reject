#!/usr/bin/env -S python3 -I
"""Reject and delete a pending research report. Run this in your own terminal, not through Claude.

  qr-reject [job-id] [--no-pager]
"""
import runpy
import sys
from pathlib import Path

sys.argv[0] = "qr-reject"
approve = runpy.run_path(str(Path(__file__).resolve().parent / "qr-approve"), run_name="qr_approve")
sys.exit(approve["main"](sys.argv[1:], "reject"))
